clc;
close all;
clear all;

n = 15;
data = 2*randi([0,1],1,n)-1;
sps = 20;

tx_signal = repelem(data,sps);

channel = [1 0.5 0.3];

distorted_signal = filter(channel,1,tx_signal);

noise = 0.2*randn(size(tx_signal));

rx_signal = distorted_signal+noise;

m = 7;
mu = 0.02;
delay = 3;
epochs = 30;

w = zeros(1,m);

y = zeros(1,length(rx_signal));
e = zeros(1,length(rx_signal));

mse = zeros(1,epochs);

for ep = 1:epochs

    for n = m:length(rx_signal)

        x = rx_signal(n:-1:n-m+1);

        y(n) = w*x';

        d = tx_signal(max(n-delay,1));

        e(n) = d-y(n);

        w = w+mu*e(n)*x;

    end

    mse(ep) = mean(e(m:end).^2);

end

figure;

subplot(4,1,1);
plot(tx_signal,'LineWidth',1.5);
title('1.Original Transmitted Signal');
ylim([-1.5 1.5]);

subplot(4,1,2);
plot(distorted_signal,'LineWidth',1.5);
title('2.After channel distortion(ISI)');

subplot(4,1,3);
plot(rx_signal,'LineWidth',1.5);
title('3.Received signal');

subplot(4,1,4);
plot(y,'LineWidth',1.5);
title('4.Equalizer Output');
ylim([-1.5 1.5]);

figure;

plot(1:epochs,mse,'-o','LineWidth',1.5);

title('Mean Squared Error');
xlabel('Epoch Number');
ylabel('MSE');

grid on;

fprintf('Final MSE after %d epochs: %.5f\n',epochs,mse(end));

fprintf('Final Equalizer weights: \n');

disp(w);
